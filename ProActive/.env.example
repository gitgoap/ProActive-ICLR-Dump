# ProActive Environment Variables
# Copy this file to .env and update paths for your environment.

# --- Data paths ---
# Root directory containing dataset folders.
# Each dataset config will look for its data under this root.
PROACTIVE_DATA_ROOT="/home/aman/MMUQ/data"

# Output directory for teacher caches, manifests, checkpoints, etc.
PROACTIVE_OUTPUT_ROOT="/home/aman/ProActive/outputs"

# --- Model paths ---
# Base directory where MLLM checkpoints are stored.
PROACTIVE_MODEL_ROOT="/home/models"

# --- HuggingFace cache ---
# Set these if you want to use a shared HF cache instead of default.
# HF_HOME="/home/aman/.cache/huggingface"
# TRANSFORMERS_CACHE="/home/aman/.cache/huggingface/transformers"

# --- GPU control ---
# Limit which GPUs are visible. Uncomment and set as needed.
# CUDA_VISIBLE_DEVICES="0,1,2,3"
