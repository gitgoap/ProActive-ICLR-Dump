# ProActive Environment Configuration Example
# Copy this file to .env and adjust the paths to match your server environment.

# ------------------------------------------------------------------------------
# Data and Output Paths
# ------------------------------------------------------------------------------
# Root directory where raw dataset files (images, questions) are stored
PROACTIVE_DATA_ROOT=/path/to/proactive/data

# Root directory where all outputs (caches, logs, checkpoints, plots) will be written
PROACTIVE_OUTPUT_ROOT=/path/to/proactive/outputs

# ------------------------------------------------------------------------------
# Hugging Face Configuration
# ------------------------------------------------------------------------------
# Directory where Hugging Face will download and cache models/datasets
HF_HOME=/path/to/huggingface/cache

# (Optional) Legacy Transformers cache dir, usually handled by HF_HOME
TRANSFORMERS_CACHE=/path/to/huggingface/cache

# (Optional) Hugging Face token if you are downloading restricted models
# HF_TOKEN=hf_...

# ------------------------------------------------------------------------------
# Hardware Execution
# ------------------------------------------------------------------------------
# Restrict the GPUs available to the scripts (e.g., "0" or "0,1,2,3")
# CUDA_VISIBLE_DEVICES=0,1,2,3
